{
  "name": "Claude Engineer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "E2B_API_KEY": "${localEnv:E2B_API_KEY}"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "postAttachCommand": "python -m compileall app.py ce3.py config.py tools prompts",
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "Claude Engineer web UI"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
